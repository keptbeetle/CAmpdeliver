# Supabase Database URL (Transaction pooler URL on port 6543)
POSTGRES_URL="postgres://postgres.[YOUR-PROJECT-ID]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres"

# Next.js Web App Credentials
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-ID].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key-here"

# Expo Mobile App Credentials (matches the Next.js credentials)
EXPO_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-ID].supabase.co"
EXPO_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key-here"
# Optional one-off override. Normal Expo dev/export commands resolve the current
# branch's latest successful Vercel Preview automatically via GitHub deployments.
# EXPO_PUBLIC_API_URL is generated by the wrapper and should not be stored here.
EXPO_API_URL_OVERRIDE=""

# Server-only authentication helpers
# Generate a long random value. Required in production so signup OTPs are stored
# as HMACs rather than reusable plaintext values.
PHONE_OTP_HASH_SECRET="replace-with-at-least-32-random-characters"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
FAST2SMS_API_KEY="your-fast2sms-api-key"

# Pilot payment amounts (paise). The receiving UPI ID and payee name are
# managed dynamically by an ADMIN from Payments & Settlements in the app.
DELIVERY_FEE_PAISE="500"
PLATFORM_FEE_PAISE="300"

# Server-side order deadlines (seconds). Purchased orders never auto-cancel.
ORDER_BROADCAST_TTL_SECONDS="600"
ORDER_ACCEPTED_TTL_SECONDS="300"
ORDER_PAYMENT_SELECTION_TTL_SECONDS="300"
ORDER_PAYMENT_VERIFICATION_TTL_SECONDS="900"
ORDER_PAID_PURCHASE_TTL_SECONDS="600"

# Protects /api/cron/orders. Use a long random server-only secret and configure
# your scheduler to send: Authorization: Bearer <CRON_SECRET>.
CRON_SECRET="replace-with-at-least-32-random-characters"
